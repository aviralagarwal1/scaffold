APP_BASE_URL=http://localhost:3000
DATABASE_URL=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Email verification delivery. Production needs RESEND_API_KEY; without it,
# verification links are only logged server-side for local development.
RESEND_API_KEY=
EMAIL_FROM=

# Hosted server-side model keys. Keep real values in .env only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Daily workspace/publication usage budget. Resets at midnight in TOKEN_USAGE_TIME_ZONE.
# Defaults: 250000 and America/New_York.
WORKSPACE_DAILY_TOKEN_LIMIT=250000
TOKEN_USAGE_TIME_ZONE=America/New_York

# Optional Python executable for the curl_cffi RSS fallback.
PYTHON=
