APP_BASE_URL=http://localhost:3000
DATABASE_URL=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Email verification delivery. Production needs RESEND_API_KEY; without it,
# verification links are only logged server-side for local development.
RESEND_API_KEY=
EMAIL_FROM=

# Hosted server-side Anthropic key. Keep real values in .env only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Product plan defaults. Changing these in production requires Cloud Run env
# updates via gcloud or the deploy workflow; unset values fall back to code defaults.
# User-facing copy says Premium; PRO_* remains the internal/env name.
FREE_MONTHLY_TOKEN_LIMIT=500000
FREE_ACTIVE_PUBLICATION_LIMIT=1
FREE_PRICE_CENTS=0
PRO_MONTHLY_TOKEN_LIMIT=2000000
PRO_ACTIVE_PUBLICATION_LIMIT=3
PRO_PRICE_CENTS=800
TOKEN_USAGE_TIME_ZONE=America/New_York

# Stripe Checkout for Premium subscriptions. STRIPE_PRO_PRICE_ID should be a
# recurring monthly Price created in Stripe for the Premium plan. Webhook events
# must be signed with STRIPE_WEBHOOK_SECRET before subscription state is synced.
STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
